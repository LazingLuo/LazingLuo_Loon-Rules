#!name = 自用通用广告平台
#!desc = 极简通用广告平台拦截

[Rule]
# Apple Ads
DOMAIN,advertising.apple.com,REJECT
DOMAIN,api-adservices.apple.com,REJECT

# 腾讯广告 / 广点通
DOMAIN,tangram.e.qq.com,REJECT
DOMAIN,mi.gdt.qq.com,REJECT

# 百度广告
DOMAIN,mobads.baidu.com,REJECT

# 字节 / 穿山甲
DOMAIN,api-access.pangolin-sdk-toutiao.com,REJECT
DOMAIN,api-access.pangolin-sdk-toutiao1.com,REJECT

# AnyThink 聚合广告
DOMAIN,adx-cn.anythinktech.com,REJECT

# 1RTB
DOMAIN,sdk.1rtb.net,REJECT
DOMAIN,zlsdk.1rtb.net,REJECT

# 快手广告
DOMAIN,open.e.kuaishou.com,REJECT
DOMAIN,open.e.kuaishou.cn,REJECT
