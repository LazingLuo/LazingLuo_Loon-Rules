#!name = 京东去开屏广告
#!icon = https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/JD.png

[Rewrite]
# 京东
^https?:\/\/m\.360buyimg\.com\/mobilecms\/s1125x2436_jfs\/ reject
^https?:\/\/storage\.360buyimg\.com\/material-video\/video\/.*\.mp4$ - reject-200

[Script]
response if ${url} ~= /^https:\/\/api\.m\.jd\.com\/client\.action\?(?:[^&]*&)*functionId=start(?:&|$)/i && ${response.status} == 200 then script("jd-splash.js") with tag="京东 start 开屏配置净化", requires_body=true, timeout=10

[MITM]
hostname = api.m.jd.com, m.360buyimg.com, storage.360buyimg.com
