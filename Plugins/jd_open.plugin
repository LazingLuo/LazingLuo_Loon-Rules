#!name = 京东开屏处理与诊断
#!desc = 处理 start 开屏配置并保留诊断，按现有 URL 规则静默拒绝图片和视频素材。
#!loon_version = 3.5.1(983)
#!date = 2026-11-07

[Script]
request if ${url} ~= /^https:\/\/api\.m\.jd\.com\/(?:api|client\.action)\?(?:[^&#]*&)*functionId=start(?:&|$)/ then script("https://raw.githubusercontent.com/LazingLuo/LazingLuo_Loon-Rules/refs/heads/main/Scripts/jd-splash.js?v=20261107-1") with tag="京东开屏请求观察", requires_body=false, timeout=10
response if ${url} ~= /^https:\/\/api\.m\.jd\.com\/(?:api|client\.action)\?(?:[^&#]*&)*functionId=start(?:&|$)/ then script("https://raw.githubusercontent.com/LazingLuo/LazingLuo_Loon-Rules/refs/heads/main/Scripts/jd-splash.js?v=20261107-1") with tag="京东开屏配置处理", requires_body=true, timeout=20
generic then script("https://raw.githubusercontent.com/LazingLuo/LazingLuo_Loon-Rules/refs/heads/main/Scripts/jd-splash.js?v=20261107-1", "export") with tag="导出京东开屏诊断记录", timeout=10
generic then script("https://raw.githubusercontent.com/LazingLuo/LazingLuo_Loon-Rules/refs/heads/main/Scripts/jd-splash.js?v=20261107-1", "reset") with tag="清空京东开屏诊断记录", timeout=5

[Rewrite]
# 仅匹配URL中的尺寸路径并直接拒绝；不读取图片正文，所有扩展名均适用。
^https?:\/\/m\.360buyimg\.com(?::(?:443|80))?\/mobilecms\/s(?:1125x2436|1125x1602)_jfs\/ reject
# 原视频目录规则：不解析视频尺寸、不运行脚本、不通知。
^https?:\/\/storage\.360buyimg\.com(?::(?:443|80))?\/material-video\/video\/[^/?#]+\.mp4(?:[?#].*)?$ reject

[Mitm]
hostname = api.m.jd.com, m.360buyimg.com, storage.360buyimg.com

