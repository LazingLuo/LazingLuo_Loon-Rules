#!name = 京东去开屏广告
#!icon = https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/JD.png

[Rewrite]
# 当前最可靠：京东 AppHome 开屏大图
^https?:\/\/m\.360buyimg\.com\/mobilecms\/s1125x2436_jfs\/.*\.(?:jpg|jpeg|png|webp)(?:\.avif)?$ - reject-200

# 可选：广告视频素材，可能影响首页活动视频
^https?:\/\/storage\.360buyimg\.com\/material-video\/video\/.*\.mp4$ - reject-200

[Script]
http-response ^https:\/\/api\.m\.jd\.com\/client\.action\?(?:[^&]*&)*functionId=start(?:&|$) script-path=https://raw.githubusercontent.com/LazingLuo/LazingLuo_Loon-Rules/refs/heads/main/Scripts/jd-splash.js,requires-body=true,timeout=10,tag=京东开屏净化,enable=true

[MITM]
hostname = api.m.jd.com, m.360buyimg.com, storage.360buyimg.com
