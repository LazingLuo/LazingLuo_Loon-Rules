#!name = 京东开屏处理
#!desc = 只改写 start 开屏配置的上线、结束日期为已过期；保留素材地址和次数，不拦截 DNS。已修改时通知。依据京东16.0.0静态分析，手机新版效果待验证。
#!loon_version = 3.5.1(983)
#!date = 2026-10-25

[Script]
response if ${url} ~= /^https:\/\/api\.m\.jd\.com\/client\.action\?(?:[^&]*&)*functionId=start(?:&|$)/i && ${response.status} == 200 then script("https://raw.githubusercontent.com/LazingLuo/LazingLuo_Loon-Rules/refs/heads/main/Scripts/jd-splash.js?v=20261025-expiry1") with tag="京东开屏配置过期处理", requires_body=true, timeout=15

[Mitm]
hostname = api.m.jd.com
