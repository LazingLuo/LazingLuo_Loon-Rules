#!name = 京东开屏
#!desc = 处理 start 开屏配置并通知，按现有 URL 规则静默拒绝图片和视频素材。
#!loon_version = 3.5.1(983)
#!date = 2026-11-07

[Script]
response if ${url} ~= /^https:\/\/api\.m\.jd\.com\/(?:api|client\.action)\?(?:[^&#]*&)*functionId=start(?:&|$)/ then script("https://raw.githubusercontent.com/LazingLuo/LazingLuo_Loon-Rules/refs/heads/main/Scripts/jd-splash.js?v=20261107-2") with tag="京东开屏配置处理", requires_body=true, timeout=20

[Rewrite]
# 仅匹配URL中的尺寸路径并直接拒绝；不读取图片正文，所有扩展名均适用。
^https?:\/\/m\.360buyimg\.com(?::(?:443|80))?\/mobilecms\/s(?:1125x2436|1125x1602)_jfs\/ reject
# 原视频目录规则：不解析视频尺寸、不运行脚本、不通知。
^https?:\/\/storage\.360buyimg\.com(?::(?:443|80))?\/material-video\/video\/[^/?#]+\.mp4(?:[?#].*)?$ reject

[Mitm]
hostname = api.m.jd.com, m.360buyimg.com, storage.360buyimg.com

