[Script]
http-response ^https:\/\/api\.m\.jd\.com\/client\.action\?(?:[^&]*&)*functionId=start(?:&|$) script-path=https://raw.githubusercontent.com/LazingLuo/LazingLuo_Loon-Rules/refs/heads/main/Scripts/jd-splash.js,requires-body=true,timeout=10,tag=京东开屏净化,enable=true
http-response ^https:\/\/api\.m\.jd\.com\/client\.action\?(?:[^&]*&)*functionId=basicConfig(?:&|$) script-path=jd-startswitch.js,requires-body=true,timeout=10,tag=京东启动开关实验,enable=true

[MITM]
hostname = api.m.jd.com, m.360buyimg.com, storage.360buyimg.com
