#!name = 肯德基去开屏广告
#!desc = 拦截动态开屏投放，清理独立开屏配置和首页配置里的开屏素材。
#!author = LazingLuo
#!loon_version = 3.5.1(983)

[Rewrite]
^https:\/\/dynamicad\.kfc\.com\.cn\/api\/app\/newad\/bootStrap\/?(?:\?|$) reject-dict

[Script]
http-response ^https?:\/\/res\.kfc\.com\.cn\/CRM\/kfcad\/(?:apphome6\/apphome_[A-Za-z0-9_-]+|bootStrap\/rn\/bootStrap_[A-Za-z0-9_-]+)\.json(?:\?|$) script-path=https://raw.githubusercontent.com/LazingLuo/LazingLuo_Loon-Rules/main/Scripts/kfc-splash.js?v=20261121-1,requires-body=true,timeout=10,tag=肯德基开屏配置

[MITM]
hostname = dynamicad.kfc.com.cn, res.kfc.com.cn
