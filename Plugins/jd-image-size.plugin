#!name = 京东开屏图片按真实尺寸拦截（实验）
#!desc = 检查京东图片响应的真实像素尺寸，命中指定开屏尺寸时替换为透明 PNG。启用后需清除京东已有缓存或卸载重装。
#!loon_version = 3.5.1(983)
#!tag = 京东,开屏广告,实验

[Argument]
sizes = input,"1125x2436,1125x1602",tag=拦截尺寸,desc=多个宽x高使用英文逗号分隔
notify = switch,true,tag=命中时通知
inspect_storage = switch,false,tag=检查 storage 域名,desc=会额外检查较大的动态模块，可能增加启动开销

[Script]
response if ${url} ~= /^https:\/\/(?:m(?:\d+)?|img\d+|nakedeye)\.360buyimg\.com\//i && ${response.status} == 200 && ${response.header['Content-Type']} ~= /^image\//i then script("https://raw.githubusercontent.com/LazingLuo/LazingLuo_Loon-Rules/refs/heads/main/Scripts/jd-image-size.js", {${sizes}, ${notify}}) with tag="京东开屏图片尺寸检查", timeout=20, requires_body=true, binary_body_mode=true
response if ${inspect_storage} == true && ${url} ~= /^https:\/\/storage(?:\d+)?\.360buyimg\.com\//i && ${response.status} == 200 && ${response.header['Content-Type']} ~= /^image\//i then script("https://raw.githubusercontent.com/LazingLuo/LazingLuo_Loon-Rules/refs/heads/main/Scripts/jd-image-size.js", {${sizes}, ${notify}}) with tag="京东 storage 图片尺寸检查", timeout=20, requires_body=true, binary_body_mode=true

[Mitm]
hostname = *.360buyimg.com
