#!name = 淘宝天猫开屏素材关联探测
#!desc = v3：记录接口覆盖和跳过原因，解析编码素材引用，图片下载后回查。候选和时间接近均不代表确认开屏。解密扩展到*.m.taobao.com和*.m.tmall.com。
#!loon_version = 3.5.1(983)

[Argument]
notify = switch,true,tag=线索通知
diagnostic = switch,false,tag=临时诊断正文,desc=测试启动时开启；限20条响应首尾片段，可能含账号业务数据，测试后关闭。已有记录不会自动清除。

[Script]
response if ${url} ~= /^https:\/\/(?:heic|img|gw|g)\.alicdn\.com\//i && ${response.status} == 200 && ${response.header['Content-Type']} ~= /^image\//i then script("https://raw.githubusercontent.com/LazingLuo/LazingLuo_Loon-Rules/refs/heads/main/Scripts/tb-image-probe.js", {${notify}}) with tag="淘宝竖屏图片探测", timeout=20, requires_body=true, binary_body_mode=true
response if ${url} ~= /^https:\/\/(?:[a-z0-9-]+\.)*(?:taobao|tmall)\.com\//i then script("https://raw.githubusercontent.com/LazingLuo/LazingLuo_Loon-Rules/refs/heads/main/Scripts/tb-config-probe.js", {${notify}, ${diagnostic}}) with tag="淘宝素材接口关联", timeout=15, requires_body=true

[Mitm]
hostname = heic.alicdn.com,img.alicdn.com,gw.alicdn.com,g.alicdn.com,*.m.taobao.com,*.m.tmall.com
