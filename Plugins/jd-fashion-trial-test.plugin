#!loon_version = 3.5.1(983)
#!date = 2026-11-25

[Script]
response if ${url} ~= /^https:\/\/api\.m\.jd\.com\/(?:api\?(?:[^#]*&)?functionId=jxzy_active_(?:querySign|drawSign)|\?(?:[^#]*&)?functionId=(?:qryH5BabelFloors|common_do_task))(?:&|$)/ && ${request.method} == "POST" && ${response.status} == 200 && ${request.header['Referer']} ~= /^https:\/\/pro\.m\.jd\.com\/mall\/active\/(?:jgwurvXVswT7VFuX4S5DG2aaK1T|G7sQ92vWSBsTHzk4e953qUGWQJ4)\/index\.html(?:\?|$)/ then script("https://raw.githubusercontent.com/LazingLuo/LazingLuo_Loon-Rules/main/Scripts/jd-fashion-trial-test-capture.js?v=20261125-1") with tag="服饰美妆与试用领取凭据", requires_body=true, timeout=20
generic then script("https://raw.githubusercontent.com/LazingLuo/LazingLuo_Loon-Rules/main/Scripts/jd-fashion-trial-test.js?v=20261125-1") with tag="手动执行服饰美妆和试用领取", timeout=300

[Mitm]
hostname = api.m.jd.com
