#!name = 京东馆签到（独立测试）
#!icon = https://raw.githubusercontent.com/LazingLuo/LazingLuo_Loon-Rules/main/icons/jd.png
#!desc = 手动测试手机馆、医疗器械馆。首次请在各自入口手动签到以保存本机凭据。
#!author = LazingLuo
#!loon_version = 3.5.1(983)
#!date = 2026-11-22

[Script]
response if ${url} ~= /^https:\/\/api\.m\.jd\.com\/api\?(?:[^#]*&)?functionId=jxzy_active_(?:querySign|drawSign)(?:&|$)/ && ${request.method} == "POST" && ${response.status} == 200 then script("https://raw.githubusercontent.com/LazingLuo/LazingLuo_Loon-Rules/main/Scripts/jd-hall-checkin-test-capture.js?v=20261122-1") with tag="手机馆和医疗器械馆凭据", requires_body=true, timeout=20
generic then script("https://raw.githubusercontent.com/LazingLuo/LazingLuo_Loon-Rules/main/Scripts/jd-hall-checkin-test.js?v=20261122-1") with tag="手动执行手机馆和医疗器械馆签到", timeout=300

[Mitm]
hostname = api.m.jd.com
