#!name = 美团3880直跳测试
#!desc = 观察美团下发的当轮地址，供配套快捷指令单轮测试。
#!loon_version = 3.5.1(983)
#!date = 2026-11-25

[Argument]
pairing = input,"",type=string,tag=配对码,desc=粘贴配套快捷指令的整行配对配置

[Script]
response if ${url} ~= /^https:\/\/lx0\.meituan\.com\/(?:\?[^#]*)?$/ && ${request.method} == "POST" then script("https://raw.githubusercontent.com/LazingLuo/LazingLuo_Loon-Rules/refs/heads/main/Scripts/meituan-3880-link.js?v=20261125-1") with tag="美团3880观察埋点", requires_body=true, timeout=10
response if ${url} ~= /^https:\/\/contents\.meituan\.com\/commerce\/(?:ad\/incentive\/getMultiTask|launch\/ad\/(?:getAdDependentInfo|batchGetAdDependentInfo))(?:\?[^#]*)?$/ then script("https://raw.githubusercontent.com/LazingLuo/LazingLuo_Loon-Rules/refs/heads/main/Scripts/meituan-3880-link.js?v=20261125-1") with tag="美团3880观察任务响应", requires_body=true, timeout=10
request if ${url} ~= /^http:\/\/example\.com\/loon-meituan-3880\/v1\/(?:probe|link)$/ then script("https://raw.githubusercontent.com/LazingLuo/LazingLuo_Loon-Rules/refs/heads/main/Scripts/meituan-3880-link.js?v=20261125-1", {${pairing}}) with tag="美团3880读取当轮地址", timeout=5
generic then script("https://raw.githubusercontent.com/LazingLuo/LazingLuo_Loon-Rules/refs/heads/main/Scripts/meituan-3880-link.js?v=20261125-1") with tag="查看美团3880链接状态", timeout=5

[Rule]
DOMAIN,example.com,DIRECT

[MITM]
hostname = lx0.meituan.com, contents.meituan.com
