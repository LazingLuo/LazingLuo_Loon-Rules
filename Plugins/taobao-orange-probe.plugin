#!name = 淘宝 Orange 配置观察
#!desc = 观察独立开屏配置，只记录计数和少量已知开关。保留淘宝DNS及原始请求响应；尚待手机验证。
#!author = LazingLuo
#!loon_version = 3.5.1(983)
#!date = 2026-10-25

[Argument]
notify = switch,true,tag=检查通知,desc=收到响应和找到开屏设置时通知，同类通知每小时最多一次

[Script]
request if ${url} ~= /^https?:\/\//i && (${url} ~= /^https?:\/\/(?:orange-dc\.m\.taobao\.com|dorangesource\.alicdn\.com)(?::[0-9]+)?(?:\/|$)/i || ${request.header['Host']} ~= /^(?:orange-dc\.m\.taobao\.com|dorangesource\.alicdn\.com)(?::[0-9]+)?$/i) then script("https://raw.githubusercontent.com/LazingLuo/LazingLuo_Loon-Rules/refs/heads/main/Scripts/taobao-orange-probe.js?v=20261025-1") with tag="Orange请求观察", timeout=5, requires_body=false
response if ${url} ~= /^https?:\/\//i && (${url} ~= /^https?:\/\/(?:orange-dc\.m\.taobao\.com|dorangesource\.alicdn\.com)(?::[0-9]+)?(?:\/|$)/i || ${request.header['Host']} ~= /^(?:orange-dc\.m\.taobao\.com|dorangesource\.alicdn\.com)(?::[0-9]+)?$/i) then script("https://raw.githubusercontent.com/LazingLuo/LazingLuo_Loon-Rules/refs/heads/main/Scripts/taobao-orange-probe.js?v=20261025-1", {${notify}}) with tag="Orange响应观察", timeout=10, requires_body=true
generic then script("https://raw.githubusercontent.com/LazingLuo/LazingLuo_Loon-Rules/refs/heads/main/Scripts/taobao-orange-probe.js?v=20261025-1", "stats") with tag="Orange检查结果", timeout=5
generic then script("https://raw.githubusercontent.com/LazingLuo/LazingLuo_Loon-Rules/refs/heads/main/Scripts/taobao-orange-probe.js?v=20261025-1", "reset") with tag="清空Orange检查记录", timeout=5

[Mitm]
hostname = orange-dc.m.taobao.com, dorangesource.alicdn.com
