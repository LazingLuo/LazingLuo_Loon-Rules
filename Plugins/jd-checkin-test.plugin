#!name = 京东每日自动签到
#!desc = 每天定时后随机延迟参数指定的秒数，按各项开关依次执行普通签到、每日刮卡和PLUS每日盲盒，项目之间随机停顿后汇总通知。每项每天最多提交一次，保留手动入口，凭据只存本地。
#!loon_version = 3.5.1(983)

[Argument]
refreshLogin = switch,true,tag=日常更新登录凭据,desc=正常使用京东时同步已保存的同账号登录凭据；首次仍需获取各活动凭据
capture = switch,false,tag=获取活动凭据,desc=进入普通签到、每日刮卡及PLUS盲盒页，保存成功后关闭

autoEnabled = switch,true,tag=自动签到总开关,desc=控制以下三项自动签到；关闭后仍可手动执行
dailyEnabled = switch,true,tag=普通签到自动执行
scratchEnabled = switch,true,tag=每日刮卡自动执行
blindboxEnabled = switch,true,tag=PLUS盲盒自动执行
cronExp = input,"0 0 * * *",tag=签到时间,desc=默认每天00:00后随机延迟参数指定的秒数；五段依次为分 时 日 月 周

delayMin = input,"0",tag=随机延迟最小秒数,desc=填写0–2000的整数；0表示允许立即开始
delayMax = input,"1200",tag=随机延迟最大秒数,desc=填写0–2000的整数且不小于最小值；两者相同表示固定延迟

taskGapExtra = input,"5",tag=任务间随机增加秒数,desc=填写0–300的整数；固定至少5秒，填5为随机5–10秒，填0为固定5秒；仅在已开启的项目之间停顿

[Script]
response if ${url} ~= /^https:\/\/api\.m\.jd\.com\/client\.action\?(?:[^#&]*&)*functionId=(?:startup|logConfig|queryPagePopWindow|babelGetGuideTips)(?:&|$)/ && ${request.method} == "POST" && ${response.status} == 200 then script("https://raw.githubusercontent.com/LazingLuo/LazingLuo_Loon-Rules/refs/heads/main/Scripts/jd-checkin-login-capture.js") with tag="京东日常登录凭据同步", requires_body=true, timeout=10, enable=${refreshLogin}
response if ${url} ~= /^https:\/\/api\.m\.jd\.com\/(?:api|client\.action)\?(?:[^#&]*&)*functionId=(?:findBeanSceneNew|bff_rightsCenter_jdInteractTask|bff_rightsCenter_interaction|bff_marketing_interaction)(?:&|$)/i && ${request.method} == "POST" && ${response.status} == 200 then script("https://raw.githubusercontent.com/LazingLuo/LazingLuo_Loon-Rules/refs/heads/main/Scripts/jd-checkin-capture.js") with tag="京东签到凭据获取", requires_body=true, timeout=15, enable=${capture}
cron ${cronExp} then script("https://raw.githubusercontent.com/LazingLuo/LazingLuo_Loon-Rules/refs/heads/main/Scripts/jd-checkin.js", {${delayMin}, ${delayMax}, ${dailyEnabled}, ${scratchEnabled}, ${blindboxEnabled}, ${taskGapExtra}}) with tag="京东每日自动签到", timeout=3000, enable=${autoEnabled}
generic then script("https://raw.githubusercontent.com/LazingLuo/LazingLuo_Loon-Rules/refs/heads/main/Scripts/jd-checkin.js", "blindbox") with tag="京东PLUS每日盲盒手动执行", timeout=90
generic then script("https://raw.githubusercontent.com/LazingLuo/LazingLuo_Loon-Rules/refs/heads/main/Scripts/jd-checkin.js", "daily") with tag="京东普通签到手动执行", timeout=60
generic then script("https://raw.githubusercontent.com/LazingLuo/LazingLuo_Loon-Rules/refs/heads/main/Scripts/jd-checkin.js", "scratch") with tag="京东每日刮卡手动执行", timeout=60
generic then script("https://raw.githubusercontent.com/LazingLuo/LazingLuo_Loon-Rules/refs/heads/main/Scripts/jd-checkin.js", "status") with tag="京东签到最近结果", timeout=10

[Mitm]
hostname = api.m.jd.com
