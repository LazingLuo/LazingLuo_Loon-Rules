#!name = 京喜自营每日签到
#!desc = 独立处理京喜自营店三天签到，先查询、领取一次再复查。独立凭据和记录，保留手动入口；不做分享助力或额外任务。先手动验证，再开启定时。
#!loon_version = 3.5.1(983)

[Argument]
capture = switch,false,tag=获取京喜凭据,desc=首次开启后进入京喜自营店页面，收到凭据已保存通知后关闭；今天已签到也可以获取
refreshLogin = switch,true,tag=京喜页面刷新凭据,desc=再次进入京喜自营页面时刷新本插件已有的同账号凭据；不读取其他签到插件数据
autoEnabled = switch,false,tag=自动签到,desc=手动验证成功后开启；关闭后仍可手动执行
cronExp = input,"0 0 * * *",tag=签到时间,desc=默认每天00:00，之后按下方参数随机延迟
delayMin = input,"0",tag=随机延迟最小秒数,desc=填写0–2000的整数；0表示允许立即开始
delayMax = input,"1200",tag=随机延迟最大秒数,desc=填写0–2000的整数且不小于最小值；两者相同表示固定延迟

[Script]
response if ${url} ~= /^https:\/\/api\.m\.jd\.com\/api\?(?:[^#&]*&)*functionId=jxzy_active_(?:querySign|drawSign|queryActive)(?:&|$)/ && ${request.method} == "POST" && ${response.status} == 200 then script("https://raw.githubusercontent.com/LazingLuo/LazingLuo_Loon-Rules/refs/heads/main/Scripts/jd-jxzy-checkin-capture.js", {${capture}, ${refreshLogin}}) with tag="京喜自营签到凭据获取与刷新", requires_body=true, timeout=15
cron ${cronExp} then script("https://raw.githubusercontent.com/LazingLuo/LazingLuo_Loon-Rules/refs/heads/main/Scripts/jd-jxzy-checkin.js", {${delayMin}, ${delayMax}}) with tag="京喜自营自动签到", timeout=2160, enable=${autoEnabled}
generic then script("https://raw.githubusercontent.com/LazingLuo/LazingLuo_Loon-Rules/refs/heads/main/Scripts/jd-jxzy-checkin.js", "manual") with tag="京喜自营手动签到", timeout=90
generic then script("https://raw.githubusercontent.com/LazingLuo/LazingLuo_Loon-Rules/refs/heads/main/Scripts/jd-jxzy-checkin.js", "status") with tag="京喜自营签到最近结果", timeout=10

[Mitm]
hostname = api.m.jd.com
