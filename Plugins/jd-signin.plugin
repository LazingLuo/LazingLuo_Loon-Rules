#!name = 京东合并签到
#!desc = 普通签到、每日刮卡、PLUS盲盒、京喜、金融与双签、家电家居、京东指数、看病买药、互动游戏、装备馆、赚话费、五金城、特价二手。一个手动入口，自动执行同一流程；各项之间随机等待，结束后统一通知。凭据自动保存在本机；请停用原签到插件及重叠的凭据获取规则。
#!loon_version = 3.5.1(983)
#!date = 2026-11-03

[Argument]
autoEnabled = switch,true,tag=自动签到,desc=关闭后仍可手动执行全部签到
startDelaySeconds = input,"1800",tag=自动启动随机延迟上限（秒）,desc=填0–1800；到点后随机等待0至此秒数再开始；填0立即开始；手动执行不等待
gapSeconds = input,"15",tag=任务间随机等待上限（秒）,desc=填5–120，实际每项间随机等待5秒至该数值；填0不等待
cronExp = input,"0 0 * * *",tag=自动执行时间,desc=默认每天00:00。依次填写分 时 日 月 周；每天10:00填0 10 * * *

[Script]
response if ${url} ~= /^https:\/\/api\.m\.jd\.com\/(?:api|client\.action)?(?![^#]*[?&]functionId=start(?:&|$))(?:\?|$)/ && ${request.method} == "POST" && ${response.status} == 200 then script("https://raw.githubusercontent.com/LazingLuo/LazingLuo_Loon-Rules/refs/heads/main/Scripts/jd-signin-capture.js?v=20261103-4") with tag="京东统一凭据获取", requires_body=true, timeout=20
response if ${url} ~= /^https:\/\/api\.m\.jd\.com\/(?:api|client\.action)?(?![^#]*[?&]functionId=start(?:&|$))(?:\?|$)/ && ${request.method} == "GET" && ${url} ~= /[?&]functionId=bom_doInteractiveAssignment(?:&|$)/ && ${response.status} == 200 then script("https://raw.githubusercontent.com/LazingLuo/LazingLuo_Loon-Rules/refs/heads/main/Scripts/jd-signin-capture.js?v=20261103-4") with tag="京东统一凭据获取", requires_body=true, timeout=20
response if ${url} ~= /^https:\/\/ms\.jr\.jd\.com\/gw2\/generic\/(?:jrSign\/h5\/m\/(?:queryWeekSignMain|queryCashSignSub|dailyCashSignReceive)|legogw\/h5\/m\/getPageInfoDoubleSignInForH5)(?:\?|$)/ && ${request.method} == "POST" && ${response.status} == 200 then script("https://raw.githubusercontent.com/LazingLuo/LazingLuo_Loon-Rules/refs/heads/main/Scripts/jd-signin-capture.js?v=20261103-4") with tag="金融签到凭据获取", requires_body=true, timeout=20
cron ${cronExp} then script("https://raw.githubusercontent.com/LazingLuo/LazingLuo_Loon-Rules/refs/heads/main/Scripts/jd-signin.js?v=20261103-2", {${gapSeconds}, ${startDelaySeconds}, ${autoEnabled}}) with tag="京东全部签到（自动）", timeout=4800, enable=${autoEnabled}
generic then script("https://raw.githubusercontent.com/LazingLuo/LazingLuo_Loon-Rules/refs/heads/main/Scripts/jd-signin.js?v=20261103-2", {${gapSeconds}}) with tag="手动执行全部签到", timeout=3000

[Mitm]
hostname = api.m.jd.com, ms.jr.jd.com

