#!name = 淘宝开屏拦截与命中通知
#!desc = 专用开屏接口拦截、首页开屏时间改写及窄范围素材规则。加入4个临时网关IP做定向MitM验证，保留HTTPDNS。需已信任MitM证书。
#!author = FFDNS[https://github.com/Thelongdarkorg/loon-plugins]；LazingLuo
#!loon_version = 3.5.1(983)
#!date = 2026-10-29

[Argument]
notify = switch,true,tag=命中通知,desc=接口拦截、实际时间改写和素材匹配时通知；普通配置响应只计数
assets = switch,true,tag=开屏素材规则,desc=按CDN路径与已选尺寸匹配；普通图片受影响时关闭

[Script]
request if ${url} ~= /^https:\/\/(?:acs\.m\.taobao\.com|guide-acs\.m\.taobao\.com|106\.11\.226\.222|59\.82\.9\.242|203\.119\.238\.85|203\.119\.238\.234)(?::443)?\/(?:gw|h5)\/mtop\.etao\.noah\.query\/[0-9]+(?:\.[0-9]+)*\/?\?[^#]*tao_splash/ then script("https://raw.githubusercontent.com/LazingLuo/LazingLuo_Loon-Rules/refs/heads/main/Scripts/taobao-splash-notify.js?v=20261029-1", {${notify}, ${assets}}) with tag="淘宝开屏_tao-splash", timeout=10
request if ${url} ~= /^https:\/\/(?:acs\.m\.taobao\.com|guide-acs\.m\.taobao\.com|106\.11\.226\.222|59\.82\.9\.242|203\.119\.238\.85|203\.119\.238\.234)(?::443)?\/(?:gw|h5)\/mtop\.taobao\.wireless\.home\.splash\.awesome\.get(?:\/[0-9]+(?:\.[0-9]+)*\/?)?(?:\?|$)/ then script("https://raw.githubusercontent.com/LazingLuo/LazingLuo_Loon-Rules/refs/heads/main/Scripts/taobao-splash-notify.js?v=20261029-1", {${notify}, ${assets}}) with tag="淘宝开屏_home-splash", timeout=10
request if ${url} ~= /^https:\/\/heic\.alicdn\.com(?::443)?\/imgextra\/i\d\/[A-Za-z0-9_!]+-\d+-tps-(?:720-1280|1080-1920|1125-1602|1125-1950|1242-2208)\.png_\d+x\d*q\d+\.jpg_\.heic(?:\?[^#]*)?$/ then script("https://raw.githubusercontent.com/LazingLuo/LazingLuo_Loon-Rules/refs/heads/main/Scripts/taobao-splash-notify.js?v=20261029-1", {${notify}, ${assets}}) with tag="淘宝开屏_heic-1", timeout=10, enable=${assets}
request if ${url} ~= /^https:\/\/heic\.alicdn\.com(?::443)?\/imgextra\/i\d\/[A-Za-z0-9_!]+-\d+-tps-(?:720-1280|1080-1920|1125-1602|1125-1950|1242-2208)\.jpg_\d+x\d*q\d+\.jpg_\.heic(?:\?[^#]*)?$/ then script("https://raw.githubusercontent.com/LazingLuo/LazingLuo_Loon-Rules/refs/heads/main/Scripts/taobao-splash-notify.js?v=20261029-1", {${notify}, ${assets}}) with tag="淘宝开屏_heic-2", timeout=10, enable=${assets}
request if ${url} ~= /^https:\/\/heic\.alicdn\.com(?::443)?\/imgextra\/i\d\/\d*\/?[\w!]+-\d-(?:octopus|tps)-(?:720-1280|1080-1920|1125-1602|1125-1950|1242-2208)\.(?:jpg|png)_(?:1\d{3}|9\d{2})x(?:\d|1\d{3}|9\d{2})q[59]0(?:\.[A-Za-z0-9_.-]+)*(?:\?[^#]*)?$/ then script("https://raw.githubusercontent.com/LazingLuo/LazingLuo_Loon-Rules/refs/heads/main/Scripts/taobao-splash-notify.js?v=20261029-1", {${notify}, ${assets}}) with tag="淘宝开屏_heic-3", timeout=10, enable=${assets}
request if ${url} ~= /^(?:https:\/\/gw\.alicdn\.com(?::443)?|http:\/\/gw\.alicdn\.com(?::80)?)\/imgextra\/i\d+\/[^\/?#]+_!!\d+-\d+-tps-(?:720-1280|1080-1920|1125-1602|1242-2208)\.(?:jpg|png|jpeg)_[^\/?#]+\.webp(?:\?[^#]*)?$/ then script("https://raw.githubusercontent.com/LazingLuo/LazingLuo_Loon-Rules/refs/heads/main/Scripts/taobao-splash-notify.js?v=20261029-1", {${notify}, ${assets}}) with tag="淘宝开屏_webp", timeout=10, enable=${assets}
response if ${url} ~= /^https:\/\/(?:acs\.m\.taobao\.com|guide-acs\.m\.taobao\.com|106\.11\.226\.222|59\.82\.9\.242|203\.119\.238\.85|203\.119\.238\.234)(?::443)?\/(?:gw|h5)\/(mtop\.taobao\.wireless\.home\.[a-z0-9_.]+)(?:\/[0-9]+(?:\.[0-9]+)*\/?)?(?:\?|$)/ && ${response.status} == 200 then script("https://raw.githubusercontent.com/LazingLuo/LazingLuo_Loon-Rules/refs/heads/main/Scripts/taobao-splash-notify.js?v=20261029-1", {${notify}, ${assets}}) with tag="淘宝首页开屏时间", timeout=10, requires_body=true
generic then script("https://raw.githubusercontent.com/LazingLuo/LazingLuo_Loon-Rules/refs/heads/main/Scripts/taobao-splash-notify.js?v=20261029-1", "stats") with tag="淘宝开屏命中统计", timeout=10

[Mitm]
hostname = acs.m.taobao.com, guide-acs.m.taobao.com, 106.11.226.222, 59.82.9.242, 203.119.238.85, 203.119.238.234, heic.alicdn.com, gw.alicdn.com
