#!name = 京东三项签到（独立测试）
#!icon = https://raw.githubusercontent.com/LazingLuo/LazingLuo_Loon-Rules/main/icons/jd.png
#!desc = 手动测试母婴馆、零食广场、家庭常备。首次请在各自入口手动签到以保存本机凭据。
#!author = LazingLuo
#!loon_version = 3.5.1(983)
#!date = 2026-11-24

[Script]
response if ${url} ~= /^https:\/\/api\.m\.jd\.com\/(?:api\?(?:[^#]*&)?functionId=jxzy_active_(?:querySign|drawSign)|\?(?:[^#]*&)?functionId=bean_deliverySign_(?:home|sign)|client\.action\?(?:[^#]*&)?functionId=mb2capp_ma_(?:queryActivityPageInfo|doDailyAttendance))(?:&|$)/ && ${request.method} == "POST" && ${response.status} == 200 then script("https://raw.githubusercontent.com/LazingLuo/LazingLuo_Loon-Rules/main/Scripts/jd-three-channel-test-capture.js?v=20261124-1") with tag="京东三项签到凭据", requires_body=true, timeout=20
generic then script("https://raw.githubusercontent.com/LazingLuo/LazingLuo_Loon-Rules/main/Scripts/jd-three-channel-test.js?v=20261124-1") with tag="手动执行母婴馆、零食广场、家庭常备签到", timeout=300

[Mitm]
hostname = api.m.jd.com
