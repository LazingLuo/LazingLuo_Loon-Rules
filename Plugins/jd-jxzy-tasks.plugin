#!name = 京喜自营任务（手动）
#!desc = 共用青龙接入／京喜签到保存在Loon的京喜凭据。手动查询任务、按要求计时后提交并领奖，或只领取已完成任务。执行进度在日志和最近结果中查看；不跳转App，不做分享助力和小组件，不设置定时。
#!loon_version = 3.5.1(983)
#!date = 2026-10-20

[Script]
generic then script("https://raw.githubusercontent.com/LazingLuo/LazingLuo_Loon-Rules/refs/heads/main/Scripts/jd-jxzy-tasks.js?v=20261020-1", "query") with tag="京喜任务查询", timeout=60
generic then script("https://raw.githubusercontent.com/LazingLuo/LazingLuo_Loon-Rules/refs/heads/main/Scripts/jd-jxzy-tasks.js?v=20261020-1", "all") with tag="京喜任务执行并领取", timeout=600
generic then script("https://raw.githubusercontent.com/LazingLuo/LazingLuo_Loon-Rules/refs/heads/main/Scripts/jd-jxzy-tasks.js?v=20261020-1", "claim") with tag="京喜任务只领取", timeout=600
generic then script("https://raw.githubusercontent.com/LazingLuo/LazingLuo_Loon-Rules/refs/heads/main/Scripts/jd-jxzy-tasks.js?v=20261020-1", "status") with tag="京喜任务最近结果与进度", timeout=10
