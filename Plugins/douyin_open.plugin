#!name = 抖音开屏净化
#!desc = 按抖音 41.2.0 的专用路径处理开屏，按命中类型通知。
#!author = LazingLuo
#!loon_version = 3.5.1(983)
#!date = 2026-11-21

[Argument]
notify = switch,true,tag=命中通知,desc=显示每次命中的开屏接口类型

[Script]
request if ${url} ~= /^https:\/\/(?:aweme\.snssdk\.com|api[0-9]*-normal-[a-z0-9-]+\.amemv\.com)(?::443)?\/api\/ad\/(?:splash\/aweme\/v1[45]|splash\/realtime\/aweme\/v15|(?:splash\/stock\/realtime\/v1[45]|v1\/splash\/stock)|v16\/splash\/preload)\/?(?:\?|$)/ then script("https://raw.githubusercontent.com/LazingLuo/LazingLuo_Loon-Rules/refs/heads/main/Scripts/douyin-splash.js?v=20261121-1", {${notify}}) with tag="抖音开屏净化", timeout=5

[Mitm]
hostname = aweme.snssdk.com, api*-normal-*.amemv.com
