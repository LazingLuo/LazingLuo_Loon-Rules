#!name = 联通每日自动签到
#!desc = 每天到设定时间后随机延迟0至20分钟，再查询、签到、复查并通知，保留手动执行入口。不处理月签、看视频或其他活动。凭据只保存在 Loon 本地。
#!loon_version = 3.5.1(983)

[Argument]
capture = switch,false,tag=获取签到凭据,desc=打开联通每日签到页面，收到凭据已保存通知后关闭

autoEnabled = switch,true,tag=自动签到,desc=关闭后仍可手动执行
cronExp = input,"0 12 * * *",tag=签到时间,desc=默认每天12:00；五段依次为分 时 日 月 周，例如30 9 * * *表示每天09:30

[Script]
response if ${url} ~= /^https:\/\/activity\.10010\.com\/sixPalaceGridTurntableLottery\/signin\/getContinuous(?:\?|$)/ && ${request.method} == "GET" && ${response.status} == 200 then script("https://raw.githubusercontent.com/LazingLuo/LazingLuo_Loon-Rules/refs/heads/main/Scripts/unicom-checkin.js", "capture") with tag="联通签到凭据获取", requires_body=true, timeout=15, enable=${capture}
cron ${cronExp} then script("https://raw.githubusercontent.com/LazingLuo/LazingLuo_Loon-Rules/refs/heads/main/Scripts/unicom-checkin.js", "cron") with tag="联通每日自动签到", timeout=1260, enable=${autoEnabled}
generic then script("https://raw.githubusercontent.com/LazingLuo/LazingLuo_Loon-Rules/refs/heads/main/Scripts/unicom-checkin.js", "manual") with tag="联通每日签到手动执行", timeout=60
generic then script("https://raw.githubusercontent.com/LazingLuo/LazingLuo_Loon-Rules/refs/heads/main/Scripts/unicom-checkin.js", "status") with tag="联通签到最近结果", timeout=10

[Mitm]
hostname = activity.10010.com
